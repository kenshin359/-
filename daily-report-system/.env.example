# ============================================================
#  Libetee AI 日報システム  環境変数サンプル
# ------------------------------------------------------------
#  このファイルを .env にコピーして値を記入してください。
#      cp .env.example .env
#  .env は .gitignore で除外され、コミットされません。
#  値が未確定のものは「要設定」または TODO のままにしておき、
#  後から差し替えてください。
# ============================================================

# ── Kintone 接続 ─────────────────────────────────────────
# サブドメインを含む完全な URL（末尾スラッシュなし）
#   例: https://libetee.cybozu.com
KINTONE_BASE_URL=https://w6pq7i12hn4b.cybozu.com

# スタッフ日報アプリのアプリID（数字）  … 要設定（Phase1 で作成後に判明）
KINTONE_DAILY_REPORT_APP_ID=TODO

# AI経営日報アプリのアプリID（数字）    … 要設定（Phase1 で作成後に判明）
KINTONE_AI_REPORT_APP_ID=TODO

# スタッフ日報アプリの APIトークン（レコード閲覧 権限）  … 要設定
KINTONE_API_TOKEN_DAILY_REPORT=TODO

# AI経営日報アプリの APIトークン（レコード追加/編集 権限）… 要設定
KINTONE_API_TOKEN_AI_REPORT=TODO

# ── Claude API ───────────────────────────────────────────
# Anthropic のAPIキー（https://console.anthropic.com で発行）… 要設定
ANTHROPIC_API_KEY=TODO
# 使用モデル（推奨: 最新の Claude。必要に応じて変更可）
ANTHROPIC_MODEL=claude-sonnet-5

# ── LINE Messaging API ───────────────────────────────────
# 長期のチャネルアクセストークン（LINE Developers で発行）… 要設定
LINE_CHANNEL_ACCESS_TOKEN=TODO
# 通知先の userId（社長 or 部長 個人へ push する場合）… 要設定（推奨は下のグループ）
LINE_TARGET_USER_ID=TODO
# 通知先の groupId（社長・部長が入ったグループへ push する場合／推奨）… 要設定
LINE_TARGET_GROUP_ID=TODO

# ── Chatwork（LINEの代わり／併用も可）────────────────────
# APIトークン: Chatwork右上の自分の名前 → サービス連携 → API Token
CHATWORK_API_TOKEN=TODO
# ルームID: 通知したいルームを開いたURL末尾の数字
#   例) https://www.chatwork.com/#!rid123456789  → 123456789
CHATWORK_ROOM_ID=TODO
# 緊急通知のとき [toall] で全員に知らせるか（false で無効）
CHATWORK_MENTION_ALL_ON_URGENT=true

# ── 通知先の切り替え ─────────────────────────────────────
#   auto     … 設定があるものすべてに送る（既定・おすすめ）
#   line     … LINEだけ
#   chatwork … Chatworkだけ
#   both     … 両方
NOTIFY_CHANNELS=auto

# ── 売上レポート（Amazon / 楽天 / 自社 / Meta / RPP）─────
# CSVを置くフォルダ。省略すると data/sales/ を見ます。
SALES_DATA_DIR=

# 列の対応表。省略すると config/sales-mapping.json を使います。
SALES_MAPPING_PATH=

# 末尾にAIの気づきを1行入れるか。
#   false（既定）… 集計のみ。Claude APIを呼ばないので費用ゼロ。
#   true         … 1回あたり数円かかります（月あたり数十円程度）。
SALES_AI_COMMENT=false

# ── 楽天レビュー返信の下書き ─────────────────────────
# CS専用グループのルームID（設定すると、下書きはここだけに届きます）
CHATWORK_CS_ROOM_ID=
# レビューページURLの数字（https://review.rakuten.co.jp/shop/4/407466_407466/ の 407466）
RAKUTEN_SHOP_ID=
# 商品レビューも見る場合の商品ID（カンマ区切り・任意）
RAKUTEN_ITEM_IDS=

# ── 売上が記載されたときの通知 ───────────────────────
# 売上通知の送り先（未設定なら CHATWORK_ROOM_ID に送ります）
CHATWORK_SALES_ROOM_ID=

# ── n8n / Webhook ────────────────────────────────────────
# ワークフロー②（緊急通知）の Webhook URL（n8n が発行）… 要設定
N8N_WEBHOOK_URL=TODO
# Webhook 保護用の共有シークレット（自分で決めた任意の長い文字列）… 要設定
WEBHOOK_SECRET=TODO

# ── レポート設定 ─────────────────────────────────────────
# タイムゾーン（IANA 形式）
REPORT_TIMEZONE=Asia/Tokyo
# 定時レポート送信時刻（24時間表記 HH:MM、REPORT_TIMEZONE 基準）
REPORT_SEND_TIME=19:00

# ── 環境切り替え ─────────────────────────────────────────
# production | test  … test の場合は LINE を送らずログ出力のみ（安全）
APP_ENV=test
