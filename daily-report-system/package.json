{
  "name": "libetee-ai-daily-report",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Libetee 向け AI 日報システム: Kintone → Claude → LINE を n8n で自動化。ローカル実行用の同等スクリプトも同梱。",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "watch": "node scripts/watchNewReports.js",
    "digest": "node scripts/dailyDigest.js",
    "sales": "node scripts/salesDigest.js",
    "notify-test": "node scripts/sendTest.js",
    "backup": "node scripts/backup.js",
    "apps": "node kintone/inspectApp.js",
    "inspect": "node kintone/inspectApp.js",
    "add-fields": "node kintone/addFields.js",
    "create-apps": "node kintone/createApps.js",
    "fetch": "node scripts/fetchDailyReports.js",
    "analyze": "node scripts/callClaude.js",
    "save": "node scripts/saveAiReport.js",
    "line": "node scripts/sendLine.js",
    "pipeline": "node scripts/runPipeline.js",
    "urgent": "node scripts/urgentNotify.js",
    "test": "node --test \"test/*.test.js\"",
    "build:n8n": "node scripts/buildN8nSales.js",
    "monthly": "node scripts/monthlySalesReport.js",
    "dashboard:data": "node scripts/exportDashboardData.js",
    "dashboard": "node scripts/exportDashboardData.js && node scripts/buildDashboard.js",
    "dashboard:build": "node scripts/buildDashboard.js",
    "create-business-apps": "node kintone/createBusinessApps.js",
    "brief": "node scripts/boardBrief.js",
    "sheet": "node scripts/exportDashboardData.js && python3 scripts/buildSalesSheet.py",
    "sheet:send": "node scripts/sendSalesSheet.js",
    "replies": "node scripts/replyDrafts.js",
    "videos": "python3 scripts/analyzeVideos.py",
    "handbook": "python3 scripts/buildSnsHandbook.py",
    "sns": "python3 scripts/analyzeVideos.py && python3 scripts/buildSnsHandbook.py",
    "reviews:analyze": "node scripts/analyzeReviews.js",
    "reviews:report": "node scripts/analyzeReviews.js && python3 scripts/buildReviewReport.py",
    "product:analyze": "node scripts/analyzeProductIssues.js",
    "product:report": "node scripts/analyzeProductIssues.js && python3 scripts/buildProductReport.py"
  }
}
