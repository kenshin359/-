# 認証情報は絶対にコミットしない
.env
.env.local
*.secret

# Node
node_modules/
npm-debug.log*

# 実行時の出力（日報取得・分析結果など）
out/
*.tmp

# バックアップ（業務データを含むためコミットしない）
backups/

# 通知の記録（新規提出の検出に使用）
# ★「state/」ではなく「state/*」と書く必要があります。
#   フォルダごと除外すると、下の「!」で戻すことが git の仕様上できません。
state/*
# ただし「売上を通知した日付の一覧」だけは記録に残します。
# 定時実行のたびにサーバーが作り直されるため、この記録が無いと
# 同じ日の通知を毎晩くり返してしまうためです。
# 中身は日付だけで、売上金額や個人情報は含みません。
!state/notified-sales.json
# レビューの記録も同じ理由で残します。
# 中身は元に戻せないハッシュだけで、レビュー本文も投稿者名も含みません。
!state/replied-reviews.json
# 広告費デバッグの入出力（数字はActionsログと同じA-J符号化のみ・名称は含まない）
!state/adcost-debug-request.json
!state/adcost-debug.txt

# ★重要★ 売上・広告の実データ
# このリポジトリは公開設定のため、実際の売上CSVを絶対に置かないこと。
# 動作確認用のダミーは samples/sales/ にあります。
data/

# Python のキャッシュ
__pycache__/
*.pyc
