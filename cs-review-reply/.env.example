# ── CS専用「楽天レビュー返信 自動連携ソフト」設定 ─────────────────
# このファイルを .env にコピーして値を入れてください（.env はコミットされません）。
# ★ 認証情報（APIキー・トークン）は、この .env.example には絶対に書かないでください。

# ── 楽天ショップ情報 ───────────────────────────────
# レビューURLに出てくる「数字」のショップID
#   例）review.rakuten.co.jp/shop/4/123456_123456/ の 123456
RAKUTEN_SHOP_ID=
# 商品ページURL（item.rakuten.co.jp/○○○/）の「英字」コード
#   ※ ★落とし穴5-2：これはレビュー用の reviewItemId とは別物です
RAKUTEN_SHOP_CODE=

# ── Chatwork ───────────────────────────────────────
CHATWORK_API_TOKEN=
# CS専用グループ（返信下書きの送り先）
CHATWORK_CS_ROOM_ID=
# 制作の中国チーム向けグループ（クレーム・低評価の日次報告先）
CHATWORK_CHINA_ROOM_ID=
# SNSチーム向けグループ（好評レビュー・SNS企画に使えそうなレビューの共有先）
CHATWORK_SNS_ROOM_ID=

# ── AI（返信下書きの③④を書かせる）─────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── 実行モード ─────────────────────────────────────
# test の間は「絶対に送信せず」、ログ／画面表示だけ（本番グループへの誤爆防止）。
# 本番運用に切り替える準備ができたら production にしてください。
APP_ENV=test
