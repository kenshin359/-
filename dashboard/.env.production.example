# docker compose 用（.env にコピーして値を設定。本物の値はコミットしない）
DOMAIN=dashboard.example.com
NEXTAUTH_URL=https://dashboard.example.com
# openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_ME
# openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_ME
# 初回だけ 1 にしてデモデータを入れる（実運用前に 0 に戻す）
SEED_DEMO=0
# Kintone タスク管理(38) との同期（任意。未設定なら「未接続」表示でこのDBに保存）
KINTONE_BASE_URL=
KINTONE_TASK_APP_ID=38
KINTONE_API_TOKEN_TASK=
