# SQLite（初期版）。本番はPostgresの接続文字列に差し替え
DATABASE_URL="file:./dev.db"
# openssl rand -base64 32 で生成して差し替えること（本物の秘密は入れない）
NEXTAUTH_SECRET="REPLACE_ME"
NEXTAUTH_URL="http://localhost:3000"
# Postgres本番用（Vercel/Neon）。SQLite開発時は不要
# DIRECT_URL="postgresql://..."

# ── LINE公式アカウント AI自動応答（docs/line-ai-setup.md）─────────────
# LINE Developers > チャネル基本設定 > チャネルシークレット（Webhook署名の検証に使う）
LINE_CHANNEL_SECRET=""
# LINE Developers > Messaging API設定 > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=""
# Anthropic APIキー（https://console.anthropic.com）。未設定なら固定の案内文で返し、要対応として扱う
ANTHROPIC_API_KEY=""
# 使用モデル（省略時 claude-opus-5）
# ANTHROPIC_MODEL="claude-opus-5"
# 要対応の通知先（どちらか／両方。未設定なら通知しない）
# スタッフのLINEグループID（C から始まる。Bot をグループに招待しておく）
LINE_STAFF_GROUP_ID=""
# Chatwork（CS用ルームがあれば CHATWORK_CS_ROOM_ID、無ければ CHATWORK_ROOM_ID）
CHATWORK_API_TOKEN=""
CHATWORK_CS_ROOM_ID=""
CHATWORK_ROOM_ID=""
