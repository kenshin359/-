# SQLite（初期版）。本番はPostgresの接続文字列に差し替え
DATABASE_URL="file:./dev.db"
# openssl rand -base64 32 で生成して差し替えること（本物の秘密は入れない）
NEXTAUTH_SECRET="REPLACE_ME"
NEXTAUTH_URL="http://localhost:3000"
# Postgres本番用（Vercel/Neon）。SQLite開発時は不要
# DIRECT_URL="postgresql://..."

# Kintone タスク管理（チーム進捗）との同期。未設定ならタスクはこのDBに保存し画面に「未接続」と出す
# KINTONE_BASE_URL="https://xxxx.cybozu.com"
# KINTONE_TASK_APP_ID="38"
# KINTONE_API_TOKEN_TASK=""   # アプリのAPIトークン（レコード閲覧・追加・編集）。本物の値はVercelの環境変数へ

# LINE監査役ボット（PRO）。未設定なら /pro/line に「未接続」と出て、Webhook は何もしない
# LINE_CHANNEL_SECRET=""         # LINE Developers → チャネル基本設定 → チャネルシークレット（署名検証）
# LINE_CHANNEL_ACCESS_TOKEN=""   # Messaging API設定 → チャネルアクセストークン（長期）。本物の値はVercelの環境変数へ
# CRON_SECRET=""                 # openssl rand -base64 32。Vercel Cron が /api/line/cron を呼ぶときの Bearer
# 資料庫2.0 の Google Drive 横断検索（任意）。サービスアカウントJSONをbase64にしたものと、対象フォルダID（カンマ区切り・空なら全体）
# GOOGLE_DRIVE_SA_JSON=""
# GOOGLE_DRIVE_FOLDER_IDS=""
# 制作依頼ボード（PRO）: LP・広告の「画像作成依頼シート」（Googleスプレッドシート）。共有設定が「リンクを知っている全員」であること
# SHEET_LP_REQUESTS_ID=""        # URL の /d/ と /edit の間のID
# SHEET_LP_REQUESTS_TAB="依頼シート"
# SNS投稿カレンダー（PRO）: 「SNS投稿スケジュール（Libetee）」シート。共有設定が「リンクを知っている全員（閲覧者）」であること
# SHEET_SNS_SCHEDULE_ID=""
# SHEET_SNS_SCHEDULE_TAB=""       # 空なら最初のタブ
# 社内アンケート（PRO・管理職以上）: Googleフォーム回答のスプレッドシート。全タブを走査するのでタブ名は不要。回答本文は画面に出さない
# SHEET_SURVEY_ID=""

# AI公式ライン（お客様向け公式アカウント「リベティ公式」のAI自動応答。docs/line-ai-setup.md）。監査役ボットとは別チャネル
# LINE_SUPPORT_CHANNEL_SECRET=""        # LINE Developers → チャネル基本設定 → チャネルシークレット（Webhook署名の検証）
# LINE_SUPPORT_CHANNEL_ACCESS_TOKEN=""  # Messaging API設定 → チャネルアクセストークン（長期）。本物の値はVercelの環境変数へ
# ANTHROPIC_API_KEY=""                  # https://console.anthropic.com。未設定なら固定の案内文で返し、要対応として扱う
# ANTHROPIC_MODEL="claude-opus-5"       # 省略時 claude-opus-5
# LINE_SUPPORT_STAFF_GROUP_ID=""        # 通常は不要（公式LINEをスタッフのグループに招待すると自動登録）。固定したいときだけ
# CHATWORK_API_TOKEN="" / CHATWORK_CS_ROOM_ID=""  # 要対応をChatworkにも通知する場合（任意）

# AIアシスタント（PRO ⑦・右下ボタン。/api/ai/ask）。上の ANTHROPIC_API_KEY と共用。未設定なら「未接続（ANTHROPIC_API_KEY 未設定）」と表示し、質問できない
# ANTHROPIC_API_KEY=""                  # https://console.anthropic.com のAPIキー。本物の値はVercelの環境変数へ
# ANTHROPIC_MODEL=""                    # 使うモデルID（省略時 claude-sonnet-5。AI公式ラインと共用なので変えるときは両方に効く）
# シート連携の安全な方式（推奨）: サービスアカウントの鍵JSON（そのまま or base64）。設定するとシートはこのアカウントに共有するだけで読める（docs/sheets-setup.md）
# GOOGLE_SHEETS_SA_JSON=""
