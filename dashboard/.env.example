# SQLite（初期版）。本番はPostgresの接続文字列に差し替え
DATABASE_URL="file:./dev.db"
# openssl rand -base64 32 で生成して差し替えること（本物の秘密は入れない）
NEXTAUTH_SECRET="REPLACE_ME"
NEXTAUTH_URL="http://localhost:3000"
# Postgres本番用（Vercel/Neon）。SQLite開発時は不要
# DIRECT_URL="postgresql://..."

# Kintone タスク管理（チーム進捗）との同期。未設定ならタスクはこのDBに保存し画面に「未接続」と出す
# KINTONE_BASE_URL="https://xxxx.cybozu.com"
# KINTONE_TASK_APP_ID="38"
# KINTONE_API_TOKEN_TASK=""   # アプリのAPIトークン（レコード閲覧・追加・編集）。本物の値はVercelの環境変数へ

# LINE監査役ボット（PRO）。未設定なら /pro/line に「未接続」と出て、Webhook は何もしない
# LINE_CHANNEL_SECRET=""         # LINE Developers → チャネル基本設定 → チャネルシークレット（署名検証）
# LINE_CHANNEL_ACCESS_TOKEN=""   # Messaging API設定 → チャネルアクセストークン（長期）。本物の値はVercelの環境変数へ
# CRON_SECRET=""                 # openssl rand -base64 32。Vercel Cron が /api/line/cron を呼ぶときの Bearer
# 資料庫2.0 の Google Drive 横断検索（任意）。サービスアカウントJSONをbase64にしたものと、対象フォルダID（カンマ区切り・空なら全体）
# GOOGLE_DRIVE_SA_JSON=""
# GOOGLE_DRIVE_FOLDER_IDS=""
# 制作依頼ボード（PRO）: LP・広告の「画像作成依頼シート」（Googleスプレッドシート）。共有設定が「リンクを知っている全員」であること
# SHEET_LP_REQUESTS_ID=""        # URL の /d/ と /edit の間のID
# SHEET_LP_REQUESTS_TAB="依頼シート"
# SNS投稿カレンダー（PRO）: 「SNS投稿スケジュール（Libetee）」シート。共有設定が「リンクを知っている全員（閲覧者）」であること
# SHEET_SNS_SCHEDULE_ID=""
# SHEET_SNS_SCHEDULE_TAB=""       # 空なら最初のタブ
