// Libetee 経営AIダッシュボード — 初期版はSQLite（本番はprovider切替でPostgres移行）
// 金額はすべて税抜・円・整数。率はアプリ層で計算（docs/metrics.md）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String // admin | editor | viewer
  // --- PRO: 5段階の権限と組織 ---
  level        String     @default("staff") // ceo | director | manager | leader | staff
  teamCode     String? // Team.code
  title        String? // 役職・担当業務
  kintoneName  String? // Kintoneタスク管理の担当者名（例: 北野）
  lineUserId   String? // LINE userId（監査役ボットの紐づけ）
  skills       String? // カンマ区切り
  createdAt    DateTime   @default(now())
  auditLogs    AuditLog[]
  tasks        Task[]     @relation("assignee")
}

model Channel {
  id     String        @id @default(cuid())
  code   String        @unique // rakuten | amazon | own
  name   String
  active Boolean       @default(true)
  orders Order[]
  access AccessDaily[]
}

model Media {
  id     String    @id @default(cuid())
  code   String    @unique // meta_travel | meta_catalog | rpp | amazon_ads | google
  name   String
  active Boolean   @default(true)
  ads    AdDaily[]
}

model Warehouse {
  id    String          @id @default(cuid())
  code  String          @unique
  name  String
  moves InventoryMove[]
}

model Supplier {
  id   String          @id @default(cuid())
  code String          @unique
  name String
  pos  PurchaseOrder[]
}

model ProductSeries {
  id   String @id @default(cuid())
  code String @unique
  name String
  skus Sku[]
}

model Sku {
  id       String          @id @default(cuid())
  code     String          @unique
  seriesId String
  series   ProductSeries   @relation(fields: [seriesId], references: [id])
  size     String?
  color    String?
  name     String
  active   Boolean         @default(true)
  costs    SkuCost[]
  items    OrderItem[]
  moves    InventoryMove[]
  poLines  PoLine[]
}

// 有効期間付き原価（過去取引の原価を書き換えない）
model SkuCost {
  id        String    @id @default(cuid())
  skuId     String
  sku       Sku       @relation(fields: [skuId], references: [id])
  unitCost  Int // 円
  validFrom DateTime
  validTo   DateTime?

  @@index([skuId, validFrom])
}

model Order {
  id              String      @id @default(cuid())
  demo            Boolean     @default(false)
  channelId       String
  channel         Channel     @relation(fields: [channelId], references: [id])
  storeCode       String      @default("main")
  orderNo         String // チャネル内注文ID
  orderDate       DateTime
  shipDate        DateTime?
  status          String // ordered | shipped | cancelled
  shippingRevenue Int         @default(0)
  discount        Int         @default(0)
  taxMode         String      @default("exclusive") // exclusive | inclusive | unknown
  items           OrderItem[]
  refunds         Refund[]

  @@unique([channelId, storeCode, orderNo])
  @@index([shipDate])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id])
  lineNo     Int
  skuId      String
  sku        Sku    @relation(fields: [skuId], references: [id])
  qty        Int
  unitPrice  Int // 税抜円
  costAtSale Int? // 取引時点原価（未登録はnull=暫定）

  @@unique([orderId, lineNo])
  @@index([skuId])
}

model Refund {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  refundDate DateTime
  amount     Int
  reason     String?
  restock    Boolean  @default(false)

  @@index([refundDate])
}

model AdDaily {
  id                String   @id @default(cuid())
  demo              Boolean  @default(false)
  date              DateTime
  mediaId           String
  media             Media    @relation(fields: [mediaId], references: [id])
  account           String   @default("main")
  campaign          String   @default("-")
  spend             Int
  impressions       Int?
  clicks            Int?
  mediaCv           Int?
  attributedRevenue Int? // 媒体報告。未取得はnull（総売上で代用しない）
  attributionWindow String? // 例: 7d_click_1d_view

  @@unique([date, mediaId, account, campaign])
}

model AccessDaily {
  id        String   @id @default(cuid())
  demo      Boolean  @default(false)
  date      DateTime
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  sessions  Int
  users     Int?
  pv        Int?

  @@unique([date, channelId])
}

model Cost {
  id         String   @id @default(cuid())
  demo       Boolean  @default(false)
  date       DateTime
  scope      String // all | channel | sku
  scopeCode  String   @default("all")
  costType   String // commission | shipping | other_variable
  amount     Int
  isEstimate Boolean  @default(false)

  @@unique([date, scope, scopeCode, costType])
}

model InventoryMove {
  id          String    @id @default(cuid())
  demo        Boolean   @default(false)
  date        DateTime
  skuId       String
  sku         Sku       @relation(fields: [skuId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  moveType    String // in | out | return | adjust
  qty         Int // inは正、outは負で保存
  reason      String?
  operator    String?
  poLineId    String?   @unique // 入庫確定元（二重確定防止）

  @@index([skuId, date])
}

model PurchaseOrder {
  id         String    @id @default(cuid())
  demo       Boolean   @default(false)
  poNo       String    @unique
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  status     String // research | quote | sample | test_sale | ordered | producing | shipped | received | archived
  assignee   String?
  etaDate    DateTime?
  memo       String?
  createdAt  DateTime  @default(now())
  lines      PoLine[]
}

model PoLine {
  id       String        @id @default(cuid())
  poId     String
  po       PurchaseOrder @relation(fields: [poId], references: [id])
  skuId    String
  sku      Sku           @relation(fields: [skuId], references: [id])
  qty      Int
  unitCost Int
  currency String        @default("JPY")
  fxRate   Float? // 外貨時: 元通貨額×レート=円換算
  received Boolean       @default(false) // 入庫確定済みフラグ（一度だけ在庫反映）

  @@unique([poId, skuId])
}

model Target {
  id        String   @id @default(cuid())
  month     String // YYYY-MM
  scope     String // all | channel | media
  scopeCode String   @default("all")
  metric    String // sales | profit | ad_budget
  amount    Int
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([month, scope, scopeCode, metric])
}

model Task {
  id                String    @id @default(cuid())
  title             String
  assigneeId        String?
  assignee          User?     @relation("assignee", fields: [assigneeId], references: [id])
  dueDate           DateTime?
  priority          String    @default("mid") // high | mid | low（旧）。Kintone同期後は P1〜P4 を kPriority に持つ
  status            String    @default("todo") // todo | doing | waiting | done
  relation          String? // 関連商品・媒体
  proposalId        String?   @unique // 提案からの二重タスク化防止
  doneMemo          String?
  // --- Kintone タスク管理(38) と同じ項目（未接続時のローカル保存用）---
  team              String? // CS | 広告 | LP | SNS | TikTok | O2 | 韓国 | ユニONA | 社長室 | 人事・管理 | 経営
  assigneeName      String? // 担当者名（Kintoneの tantou）
  doneDef           String? // 完了の定義（数字で）
  kPriority         String? // P1 | P2 | P3 | P4
  impact            String? // ◎ 売上に直結 | ○ 間接（計測・基盤） | △ 体制づくり
  yanai             String? // 柳井基準（撤退・判断ライン）
  memo              String?
  kintoneId         String?   @unique // Kintoneレコード番号（同期済みなら設定）
  // --- PRO: プロジェクト・KPI・進捗・依頼元・保留 ---
  projectCode       String?
  kpiCode           String?
  progress          Int       @default(0) // 0-100
  requestedByUserId String?
  holdReason        String?
  lastActivityAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 資料庫: Googleドライブ等の資料リンクをカテゴリ付きで管理（本文は保存しない）
model Document {
  id         String   @id @default(cuid())
  title      String
  category   String // 全社共有 | 営業・EC | 広告 | CS | 総務・管理 など
  department String? // 部署・チーム
  url        String
  note       String?
  tags       String? // カンマ区切り（資料庫2.0の横断検索用）
  docType    String? // manual | contract | product | ad | logistics | hr | other
  ownerId    String?
  ownerName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Proposal {
  id          String    @id @default(cuid())
  source      String    @default("rule") // rule | llm
  ruleCode    String?
  title       String
  priority    Int       @default(2)
  targetLabel String?
  facts       String // 観測事実と根拠数値(JSON文字列)
  period      String?
  dataAsOf    DateTime?
  hypothesis  String?
  action      String?
  effectNote  String? // 効果試算（式・前提・「予測」ラベル）根拠なしで金額を生成しない
  status      String    @default("open") // open | adopted | held | rejected
  statusNote  String?
  createdAt   DateTime  @default(now())
}

model ImportBatch {
  id           String   @id @default(cuid())
  fileName     String
  dataType     String
  rowCount     Int
  errorCount   Int
  status       String // success | failed | partial
  executedById String?
  version      String   @default("v1")
  rawPath      String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// ログイン失敗回数（サーバーレス環境でもプロセスをまたいでロックを効かせるためDBに持つ）
model LoginFailure {
  email String   @id
  count Int      @default(0)
  until DateTime
}

// ===================== PRO（経営・業務管理OS）追加モデル：既存テーブルは変更しない =====================

// 部署階層。Kintoneタスク管理の「チーム」選択肢と対応付ける
model Team {
  code         String  @id // ec | ads | lp | sns | tiktok | cs | logistics | product | hr | finance | overseas | o2 | exec | ceo_office
  name         String
  parentCode   String?
  leaderUserId String?
  kintoneLabel String? // Kintone team ドロップダウンの表記（例: 広告）
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
}

model Project {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  teamCode    String?
  ownerUserId String?
  status      String    @default("active") // planned | active | hold | done | archived
  goal        String?
  kpiCode     String?
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// KPI定義（判定閾値つき）。値は KpiValue に日次で持つ
model Kpi {
  code            String     @id // 例: sales_month, ad_ratio, suitcase_cpa, cs_low_reviews
  name            String
  unit            String // 円 | % | 件 | 倍 | 個
  direction       String     @default("up") // up=大きいほど良い | down=小さいほど良い
  targetValue     Float?
  warnThreshold   Float? // 注意
  dangerThreshold Float? // 危険
  source          String     @default("manual") // metrics | kintone | manual
  teamCode        String?
  ownerUserId     String?
  note            String?
  active          Boolean    @default(true)
  values          KpiValue[]
}

model KpiValue {
  id      String   @id @default(cuid())
  kpiCode String
  kpi     Kpi      @relation(fields: [kpiCode], references: [code])
  date    DateTime
  value   Float
  note    String?
  demo    Boolean  @default(false)

  @@unique([kpiCode, date])
}

// 報告（日報 / 週報 / 中間報告）
model Report {
  id               String    @id @default(cuid())
  type             String // daily | weekly | interim
  teamCode         String?
  authorUserId     String?
  authorName       String?
  periodFrom       DateTime
  periodTo         DateTime
  title            String
  body             String // 構造化JSON（数字・学び・今日/今週・課題・依頼）
  status           String    @default("submitted") // draft | submitted | reviewed
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// アラート（ルールで生成。同じ code+entity は1件に集約し、解消でクローズ）
model Alert {
  id          String    @id @default(cuid())
  code        String // task_overdue | waiting_stale | no_assignee | stale_update | sales_pace | ad_ratio | cpa_spike | stock_out | stock_excess | task_concentration
  level       String // red | yellow
  title       String
  detail      String?
  entityType  String? // task | kpi | sku | user | team
  entityId    String?
  teamCode    String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  mutedUntil  DateTime?

  @@unique([code, entityType, entityId])
}

// クイックメモ（どの画面からでも）
model Note {
  id           String   @id @default(cuid())
  authorUserId String?
  authorName   String?
  body         String
  entityType   String?
  entityId     String?
  createdAt    DateTime @default(now())
}

// ===== LINE 監査役ボット =====
model LineGroup {
  groupId  String        @id
  name     String?
  teamCode String?
  active   Boolean       @default(true)
  joinedAt DateTime      @default(now())
  messages LineMessage[]
}

model LineMessage {
  id            String     @id @default(cuid())
  groupId       String
  group         LineGroup  @relation(fields: [groupId], references: [groupId])
  lineMessageId String     @unique
  userId        String?
  displayName   String?
  kind          String     @default("text") // text | image | file | sticker | other
  text          String?
  ts            DateTime
  extractedJson String? // AI/ルールで抽出した依頼・期限・約束（JSON）
  processedAt   DateTime?
  createdAt     DateTime   @default(now())
  followUps     FollowUp[]
}

// 追いかけ（依頼・約束の未完了をリマインド）
model FollowUp {
  id              String       @id @default(cuid())
  sourceMessageId String?
  source          LineMessage? @relation(fields: [sourceMessageId], references: [id])
  groupId         String?
  title           String
  assigneeName    String?
  due             DateTime?
  status          String       @default("open") // open | done | dropped
  taskId          String? // タスク化した場合
  remindAt        DateTime?
  remindedCount   Int          @default(0)
  lastRemindedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// 定時投稿（朝の予定・夕方のまとめ・期限リマインド）
model ScheduledPost {
  id        String    @id @default(cuid())
  groupId   String
  name      String
  cron      String // 5フィールド（JST）
  template  String // daily_summary | due_reminder | custom
  body      String?
  active    Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}
