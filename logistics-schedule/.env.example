# ── kintone 接続設定 ───────────────────────────────
# このファイルを .env にコピーして値を入れてください（.env はコミットされません）

# サブドメイン（https://XXXX.cybozu.com の XXXX の部分）
KINTONE_SUBDOMAIN=w6pq7i12hn4b

# ── 認証（どちらか一方）─────────────────────────────
# ① パスワード認証：アプリの「作成」に必要（create-app で使用）
#    ※ 専用の連携用アカウントを推奨。個人アカウントは避ける。
KINTONE_USER=
KINTONE_PASSWORD=

# ② APIトークン認証：レコードの読み書き（import で使用）
#    物流スケジュールアプリで発行し、read/write 権限を付けること。
KINTONE_API_TOKEN=

# ── アプリID ───────────────────────────────────────
# create-app 実行後に表示される「物流スケジュール」アプリのID
KINTONE_LOGI_APP_ID=

# 新規アプリ名（任意）
KINTONE_LOGI_APP_NAME=物流スケジュール

# パッキングリストの置き場（任意。既定は logistics-schedule/packing-lists）
# PL_DIR=
