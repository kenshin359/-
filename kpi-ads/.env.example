# ── O2GYM 広告売上KPI 自動連携 設定サンプル ──────────────
# このファイルを .env にコピーして値を入れる（.env はコミットされない）。
# GitHub Actions で動かす場合は、同じ名前を「リポジトリの Secrets」に登録する。

# ── kintone（必須）───────────────────────────────
KINTONE_SUBDOMAIN=w6pq7i12hn4b
# KPIアプリのID（アプリを開いた時の URL /k/<番号>/ の番号）
KINTONE_KPI_APP_ID=
# KPIアプリで発行した APIトークン（read/write 権限）
KINTONE_KPI_API_TOKEN=

# ── フィールドコード（任意）─────────────────────────
# 既定は下記 romaji。アプリのフィールドコードをこれに合わせれば設定不要。
# 違う場合だけ実際のコードに書き換える。
# KPI_FC_DATE=date
# KPI_FC_ACCESS=access
# KPI_FC_SIGNUPS=signups
# KPI_FC_SALES_STORES=sales_stores
# KPI_FC_SALES_SHOPIFY=sales_shopify
# KPI_FC_AD_GOOGLE=ad_google
# KPI_FC_AD_META=ad_meta

# ── Shopify（任意：設定すると売上を自動取得）──────────────
# SHOPIFY_SHOP=o2gym.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2024-10

# ── Meta 広告（任意）────────────────────────────────
# META_AD_ACCOUNT_ID=act_6500211260004110
# META_ACCESS_TOKEN=
# META_API_VERSION=v21.0

# ── Google 広告（任意）──────────────────────────────
# GOOGLE_ADS_CUSTOMER_ID=1234567890
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v17

# ── STORES（任意：CSVを data/stores/ に置くと自動集計）────────
# STORES_DATE_COLUMN=注文日
# STORES_AMOUNT_COLUMN=合計
