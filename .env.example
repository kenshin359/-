# ── kintone 接続設定 ───────────────────────────────
# このファイルを .env にコピーして値を入れてください（.env はコミットされません）

# サブドメイン（https://XXXX.cybozu.com の XXXX の部分）
KINTONE_SUBDOMAIN=w6pq7i12hn4b

# ── 認証（どちらか一方）─────────────────────────────
# ① パスワード認証：アプリの「作成」に必要（create-app で使用）
#    ※ 専用の連携用アカウントを推奨。社長個人のアカウントは避ける。
KINTONE_USER=
KINTONE_PASSWORD=

# ② APIトークン認証：既存アプリの読み取り／新アプリへの書き込み（migrate で使用）
#    アプリごとに発行。read/write 権限を付けること。
KINTONE_API_TOKEN=

# ── アプリID ───────────────────────────────────────
# 既存の「売上・転換率報告」アプリのID（移行元）
KINTONE_OLD_APP_ID=
# 新規作成した「売上日報（新）」アプリのID（create-app 実行後に表示される）
KINTONE_NEW_APP_ID=

# 新規アプリ名（任意）
KINTONE_NEW_APP_NAME=売上日報（新）
